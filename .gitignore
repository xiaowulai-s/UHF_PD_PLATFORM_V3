# Python
__pycache__/
*.py[cod]
*$py.class
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 上面 Python 块里的裸 lib/ 会匹配任意深度，连带吞掉前端源码目录
# desktop/src/renderer/lib/（导致 store.ts 等文件静默不入库）。定向放行。
!desktop/src/renderer/lib/
!desktop/src/renderer/lib/**

# Virtual environments
venv/
ENV/
env/

# PyCharm / VS Code / IDE
.idea/
.vscode/
.spyproject
.tox/

# Test coverage
htmlcov/
coverage
coverage.*
coverage.xml
pytest_cache/
# Pytest temporary directories
device_manager_test_*/
.pytest_temp/
.pytest_temp_local/
.pytest_runtime_tmp/
migrate_test_*/
models_check_*/
pytest-of-wo/

# Test output files
test_output.txt
test_result.txt
test_step*_output.txt
tests/_*.txt
tests/*.txt

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Project specific
data/*.db
data/*.db-journal
# SQLite WAL 边车文件：最后连接干净关闭时会被 SQLite 删除，纳入版本控制只会
# 让工作区反复出现伪"已删除"。
data/*.db-wal
data/*.db-shm
config/*.json

# Temporary files
temp/
tmp/
*.tmp
# 编辑器原子保存的残留（正本名 + .tmp.<pid>.<hash>）：不匹配上面的 *.tmp，
# 所以此前 23 个中间快照全部以未跟踪文件的形式污染 git status。
*.tmp.[0-9]*

# 清理归档区（2026-09-29 起）：只放"从工作区移走但保留"的历史内容，
# 体积 ~500M 且全是死数据，纳入版本控制没有意义，也容易被宽 add 误提交。
_archive/

# Documentation build
docs/_build/
docs/.doctrees/

# Agent / IDE 本地状态（不进版本库：AI 助手记忆、截图、编辑器权限配置）
.claude/
.workbuddy/
.workbuddy-ai/

# 运行期日志与一次性报告
logs/
soak-*.json
soak-*.log

# Screenshots (keep in repo for documentation)
# 截图*.png

# Coverage
.coverage
